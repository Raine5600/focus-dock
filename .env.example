# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook — Dashboard → Developers → Webhooks → Add endpoint
# URL: https://getfocusdock.com/api/webhook
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — not used by current server-side Checkout flow
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Site URL (required for SEO, checkout redirects, and affiliate emails)
NEXT_PUBLIC_APP_URL=https://getfocusdock.com
NEXT_PUBLIC_EMAIL_DOMAIN=getfocusdock.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@getfocusdock.com

# Zoho SMTP (smtppro.zoho.com:465) — app-specific password, not login password
# Required for /affiliates application form to send email
SMTP_USER=hello@getfocusdock.com
SMTP_APP_PASSWORD=your_zoho_app_specific_password
# Alternate name also supported by lib/mail.ts:
# ZOHO_APP_PASSWORD=your_zoho_app_specific_password

# Outreach gate — keep false until getfocusdock.com is live (see LAUNCH_CHECKLIST.md)
# email-campaign.py also verifies https://getfocusdock.com responds before --send
DOMAIN_READY=false

# Purchase log admin page at /admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional — Vercel → Storage → Blob → connect store → copy token
# Enables persistent webhook purchase logs (otherwise /admin reads from Stripe API)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...